{
  "name": "@zontafor/luxleaf-gradient-studio",
  "version": "0.2.0",
  "type": "module",
  "license": "LicenseRef-Proprietary",
  "author": "Michelle L. Wu",
  "description": "React and Vue mesh gradients, twelve shader combinations, editor adapters and reversible presets.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react-engine.d.ts",
      "import": "./dist/react-engine.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./framer": {
      "types": "./dist/framer.d.ts",
      "import": "./dist/framer.js"
    },
    "./shaders": {
      "types": "./dist/shader-sources.d.ts",
      "import": "./dist/shader-sources.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "third_party",
    "docs",
    "foundations",
    "foundation-dist",
    "src",
    "demo",
    "tests",
    "scripts",
    "integrations",
    "tsconfig.json",
    "tsconfig.build.json",
    "vite.config.ts",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:foundation && tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run verify:foundation && npm run build:foundation && npm run typecheck && npm test && npm run build",
    "build:foundation": "node scripts/build-foundation.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:foundation": "node scripts/verify-foundation.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.8.2",
    "@shadergradient/react": "^2.4.20",
    "@shadergradient/vue": "^0.1.0",
    "@tresjs/core": "^5.9.0",
    "camera-controls": "2.9.0",
    "query-string": "10.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.180.0",
    "three-stdlib": "2.36.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zontafor/luxleaf-gradient-studio.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
